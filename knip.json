{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {
      "entry": [
        ".release-it.mjs",
        ".vscode/*.mjs",
        "scripts/check-workspace-freshness.mjs",
        "scripts/mise-run.mjs"
      ]
    },
    "packages/services": {
      "entry": ["src/index.ts", "src/storage/module.ts"]
    }
  },
  "ignore": [".agents/**", "docs/**", "packages/ui/src/components/**", "apps/android/android/**"]
}
